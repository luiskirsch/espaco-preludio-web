rules_version = '2';

// Regras do Cloud Storage para o projeto Firebase compartilhado
// "osextolugar-game" (usado pelo jogo O SextoLugar e por Espaço Prelúdio).
// Antes deste arquivo, nenhuma regra de Storage jamais foi publicada aqui —
// por isso toda escrita era negada por padrão, e o upload de foto de perfil
// do colaborador falhava silenciosamente (ficava "salvando" sem persistir).
service firebase.storage {
  match /b/{bucket}/o {
    // Foto de perfil do colaborador/paciente do Espaço Prelúdio.
    // Leitura pública: a URL de download já carrega um token não-adivinhável,
    // e o <img> do app não envia header de Authorization.
    // Escrita: só o próprio usuário autenticado, no arquivo com seu uid.
    match /patient-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Tudo mais no bucket (inclusive qualquer uso futuro do jogo) permanece
    // negado por padrão, como sempre foi.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

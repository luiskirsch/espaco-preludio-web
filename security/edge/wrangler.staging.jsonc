{
  "name": "espaco-preludio-security-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "assets": {
    "directory": "../../.empresa-edge-assets",
    "binding": "EMPRESA_ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "espacopreludio.com.br/staging/*", "zone_name": "espacopreludio.com.br" },
    { "pattern": "www.espacopreludio.com.br/staging/*", "zone_name": "espacopreludio.com.br" }
  ]
}

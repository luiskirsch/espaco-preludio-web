{
  "name": "espaco-preludio-security-headers",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "routes": [
    { "pattern": "espacopreludio.com.br/*", "zone_name": "espacopreludio.com.br" },
    { "pattern": "www.espacopreludio.com.br/*", "zone_name": "espacopreludio.com.br" }
  ]
}
